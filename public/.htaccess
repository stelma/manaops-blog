# Apache config for IONOS webhosting.
#
# This file lives in public/, so Astro copies it verbatim into dist/ and the
# deploy script uploads it to the document root.
#
# IMPORTANT: do not deploy the HTTPS redirect below until your certificate is
# actually issued and active in the IONOS panel. Redirecting to HTTPS before
# then gives every visitor a certificate warning.

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Force HTTPS. Two conditions because shared hosting sometimes terminates
	# TLS at a proxy, where %{HTTPS} reads "off" even on a secure request.
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !=https
	RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

	# Canonicalise to one hostname so you don't split SEO between www and
	# apex. Uncomment ONE of these and set your domain.
	#
	# www -> apex:
	# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	# RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
	#
	# apex -> www:
	# RewriteCond %{HTTP_HOST} !^www\. [NC]
	# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# Astro fingerprints everything in /_astro/, so those URLs can be cached
# forever — a changed file gets a new name.
<IfModule mod_headers.c>
	<FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|webp|avif)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>

	# HTML must revalidate, or visitors get stale pages after a deploy.
	<FilesMatch "\.html$">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</FilesMatch>

	# Feed and sitemaps: short cache.
	<FilesMatch "\.(xml)$">
		Header set Cache-Control "public, max-age=3600"
	</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain \
		application/javascript application/json application/rss+xml \
		image/svg+xml
</IfModule>

# Don't serve the directory listing if an index is ever missing.
Options -Indexes
