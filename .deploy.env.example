# Copy to .deploy.env (gitignored) and fill in your IONOS SSH details.
# Do NOT put your password here — use an SSH key or let ssh prompt you.

# From the SSH panel in your IONOS hosting dashboard.
SSH_HOST=access-XXXXXXXX.webspace-host.com
SSH_USER=aXXXXXXXX
SSH_PORT=22

# Absolute or home-relative path to the document root on the server.
# Log in once with `ssh user@host` and check where your site is served from —
# on IONOS webhosting this is often the home directory itself, or a
# subdirectory if you host several sites. The trailing slash matters.
REMOTE_DIR=/homepages/XX/dXXXXXXXX/htdocs/
