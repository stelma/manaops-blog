# Copy to .deploy.env (gitignored) and fill in your IONOS SSH details.
# Do NOT put your password here — use an SSH key or let ssh prompt you.

# From the SSH panel in your IONOS hosting dashboard.
SSH_HOST=access-XXXXXXXX.webspace-host.com
SSH_USER=aXXXXXXXX
SSH_PORT=22

# Path to the document root on the server. Log in with `ssh user@host` and
# run `pwd` — on IONOS webhosting it looks like the line below. The trailing
# slash matters: it makes rsync copy the *contents* of dist/, not the folder.
REMOTE_DIR=/kunden/homepages/XX/dXXXXXXXX/htdocs/
