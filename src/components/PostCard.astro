---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={['card', { featured }]}>
	<a href={`/blog/${post.id}/`}>
		<p class="date"><FormattedDate date={post.data.pubDate} /></p>
		<h3 class="title">{post.data.title}</h3>
		<p class="description">{post.data.description}</p>
		<span class="more">Read <span aria-hidden="true">→</span></span>
	</a>
</article>

<style>
	.card {
		position: relative;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: linear-gradient(160deg, var(--surface), rgba(10, 23, 16, 0.6));
		overflow: hidden;
		transition:
			border-color 0.22s ease,
			transform 0.22s ease,
			box-shadow 0.22s ease;
	}
	/* A teal filament along the top edge, lit on hover. */
	.card::before {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--teal), transparent);
		opacity: 0;
		transition: opacity 0.22s ease;
	}
	.card:hover {
		border-color: var(--border-strong);
		transform: translateY(-3px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
	}
	.card:hover::before {
		opacity: 1;
	}
	.card a {
		display: block;
		padding: 1.6em;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}
	.date {
		margin: 0 0 0.7em 0;
		font-size: 0.72rem;
		letter-spacing: 3px;
		text-transform: uppercase;
		color: var(--teal);
	}
	.title {
		margin: 0 0 0.5rem 0;
		font-size: 1.25rem;
		line-height: 1.3;
		color: var(--cream);
		transition: color 0.18s ease;
	}
	.card:hover .title {
		color: var(--glow-2);
	}
	.description {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--text-muted);
	}
	.more {
		display: inline-block;
		margin-top: 1.2em;
		font-size: 0.78rem;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--teal-light);
	}
	.card:hover .more span {
		display: inline-block;
		transform: translateX(3px);
		transition: transform 0.18s ease;
	}

	/* The lead story gets the full width and a warmer edge. */
	.featured {
		background:
			radial-gradient(28rem 16rem at 100% 0%, rgba(226, 114, 46, 0.12), transparent 65%),
			linear-gradient(160deg, var(--surface-raised), rgba(10, 23, 16, 0.6));
	}
	.featured a {
		padding: 2.2em;
	}
	.featured .title {
		font-size: 1.9rem;
	}
	.featured .description {
		font-size: 1rem;
		max-width: 52ch;
	}

	@media (max-width: 720px) {
		.featured .title {
			font-size: 1.5rem;
		}
		.featured a {
			padding: 1.6em;
		}
	}
</style>
