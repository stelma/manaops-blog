---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Lockup from '../components/Lockup.astro';
import PostCard from '../components/PostCard.astro';
import Stars from '../components/Stars.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [lead, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<Stars count={30} />
				<div class="hero-content">
					<Lockup width={260} />
					<h1 class="wordmark">{SITE_TITLE}</h1>
				</div>
			</section>

			{
				posts.length > 0 && (
					<section class="posts">
						<PostCard post={lead} featured />
						{rest.length > 0 && (
							<div class="grid">
								{rest.map((post) => (
									<PostCard post={post} />
								))}
							</div>
						)}
					</section>
				)
			}
		</main>
		<Footer />

		<script>
			// Hero parallax: the star field trails the mark on scroll, so the two
			// layers read as different depths. Progressive enhancement — without
			// this script the hero is simply static.
			const hero = document.querySelector<HTMLElement>('.hero');
			const stars = hero?.querySelector<HTMLElement>('.stars');
			const content = hero?.querySelector<HTMLElement>('.hero-content');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

			if (hero && stars && content) {
				let queued = false;

				const update = () => {
					queued = false;
					const height = hero.offsetHeight;
					// Clamp: past the hero there is nothing left to move.
					const y = Math.min(window.scrollY, height);
					const progress = height > 0 ? y / height : 0;

					stars.style.transform = `translate3d(0, ${y * 0.4}px, 0)`;
					content.style.transform = `translate3d(0, ${y * 0.16}px, 0)`;
					content.style.opacity = String(1 - progress * 0.7);
				};

				const reset = () => {
					stars.style.transform = '';
					content.style.transform = '';
					content.style.opacity = '';
				};

				const onScroll = () => {
					if (queued) return;
					queued = true;
					requestAnimationFrame(update);
				};

				const apply = () => {
					if (reduceMotion.matches) {
						window.removeEventListener('scroll', onScroll);
						reset();
					} else {
						window.addEventListener('scroll', onScroll, { passive: true });
						update();
					}
				};

				apply();
				reduceMotion.addEventListener('change', apply);
			}
		</script>
	</body>
</html>

<style>
	main {
		width: 1040px;
		padding: 0 1em 4em 1em;
	}
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 4em 0 3.5em 0;
		margin-bottom: 3em;
		border-bottom: 1px solid var(--border);
		text-align: center;
	}
	.hero-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.2em;
		will-change: transform, opacity;
	}
	.hero :global(.stars) {
		will-change: transform;
	}
	.hero h1 {
		margin: 0;
		font-size: clamp(2.2rem, 5vw, 3rem);
		line-height: 1;
	}
	.posts {
		position: relative;
		z-index: 1;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5em;
		margin-top: 1.5em;
	}

	@media (max-width: 720px) {
		.hero {
			padding: 2.5em 0;
			margin-bottom: 2em;
		}
	}
</style>
